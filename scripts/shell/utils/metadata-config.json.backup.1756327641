{
  "forceIncludeTypes": {
    "critical_security_integration": {
      "description": "Critical security and integration metadata types that must always be included",
      "types": [
        "AuthProvider",
        "ExternalCredential",
        "NamedCredential",
        "RemoteSiteSetting",
        "CspTrustedSite",
        "CorsWhitelistOrigin"
      ],
      "discoveryMethod": "explicit_inclusion",
      "reason": "Essential for QuickBooks Online and other integrations - missing these breaks functionality"
    },
    "integration_dependencies": {
      "description": "Additional metadata types commonly needed for integrations",
      "types": [
        "ConnectedApp",
        "Certificate",
        "ExternalDataSource",
        "ExternalServiceRegistration"
      ],
      "discoveryMethod": "explicit_inclusion",
      "reason": "Supporting integration infrastructure and external services"
    }
  },
  "discoveryMethods": {
    "explicit_inclusion": {
      "description": "Types that are explicitly included regardless of org discovery",
      "implementation": "Always add to package manifests even if not found in org discovery",
      "fallbackBehavior": "continue_without_error"
    },
    "explicit_listing": {
      "description": "Types that require explicit member names instead of wildcards",
      "implementation": "Query for specific members and list individually in package.xml",
      "fallbackBehavior": "skip_if_no_members"
    },
    "discovery_with_retry": {
      "description": "Standard discovery with retry on failure",
      "implementation": "Include in discovery, retry with exclusion if unsupported",
      "fallbackBehavior": "exclude_on_failure"
    }
  },
  "nonWildcardTypes": [
    "LightningComponentBundle",
    "StandardValueSet"
  ],
  "unsupportedTypes": [
    "ExtlClntAppConfigurablePolicies",
    "ExtlClntAppPushConfigurablePolicies",
    "ExtlClntAppSamlConfigurablePolicies",
    "extlclntappnotificationsettings"
  ],
  "problematicTypes": [
    "MktDatalakeSrcKeyQualifier",
    "ExternalAuthIdentityProvider",
    "UiFormatSpecificationSet",
    "CustomObjectTranslation",
    "OauthTokenExchangeHandler"
  ],
  "requiresExplicitMembers": {
    "LightningComponentBundle": {
      "reason": "Salesforce API doesn't support wildcard retrieval for LWCs",
      "discovered": "2025-01",
      "workaround": "explicit_listing",
      "discoveryMethod": "explicit_listing"
    },
    "StandardValueSet": {
      "reason": "Requires explicit member names",
      "discovered": "2024-06",
      "workaround": "explicit_listing",
      "discoveryMethod": "explicit_listing"
    }
  },
  "notes": "Enhanced configuration for comprehensive metadata discovery with forced inclusion of critical types",
  "version": "2.0.0",
  "lastUpdated": "2025-08-27",
  "enhancements": "Added forceIncludeTypes and discoveryMethods for Step 1 of metadata tool enhancement plan"
}
