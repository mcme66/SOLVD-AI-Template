{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "solvd-cloud": {
      "source": {
        "source": "github",
        "repo": "SOLVD-cloud/solvd-claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "solvd-salesforce-development@solvd-cloud": true
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch(domain:help.salesforce.com)",
      "WebFetch(domain:developer.salesforce.com)",
      "WebFetch(domain:trailhead.salesforce.com)",
      "WebFetch(domain:salesforce.stackexchange.com)",
      "WebFetch(domain:code.claude.com)",
      "Skill(mermaid)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(sf *)",
      "Bash(sfdx *)",
      "Bash(npm ci)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(./scripts/shell/*)",
      "Bash(bash scripts/*)",
      "Bash(node --test *)",
      "Bash(jq *)",
      "Bash(pandoc *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(tree *)",
      "Bash(mkdir *)",
      "mcp__claude_ai_Asana__get_*",
      "mcp__claude_ai_Asana__search_*",
      "mcp__asana__asana_get_*",
      "mcp__asana__asana_search_*",
      "mcp__asana__asana_list_*"
    ],
    "ask": [
      "Bash(sf org delete *)",
      "Bash(sfdx force:org:delete *)",
      "Bash(rm *)",
      "mcp__claude_ai_Asana__create_*",
      "mcp__claude_ai_Asana__update_*",
      "mcp__claude_ai_Asana__add_*",
      "mcp__asana__asana_create_*",
      "mcp__asana__asana_update_*",
      "mcp__asana__asana_add_*"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(rm -rf *)",
      "Bash(chmod 777 *)",
      "Bash(brew *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(yarn add *)",
      "Bash(pip install *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.sf/**)",
      "Read(~/.sfdx/**)",
      "Read(./.sf/**)",
      "Read(./.sfdx/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.sf/**)",
      "Edit(./.sfdx/**)",
      "mcp__claude_ai_Asana__delete_*",
      "mcp__asana__asana_delete_*"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
